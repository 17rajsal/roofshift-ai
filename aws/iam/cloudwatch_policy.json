{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RoofShiftCloudWatchLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:ap-south-1:*:log-group:/roofshift/*"
    }
  ]
}
