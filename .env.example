# ==============================================================================
# RoofShift AI — Environment Configuration Example
# ==============================================================================

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./roofshift.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/roofshift_db

# External Public Solar APIs
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
NASA_REQUEST_TIMEOUT_SECONDS=12.0

# Reports Directory
REPORTS_DIR=./generated_reports

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8000", "*"]
